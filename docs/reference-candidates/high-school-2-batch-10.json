      "originalQuestion": {
        "q": "設 $\\vec a$，$\\vec b$，$\\vec c$ 為空間中三個相異的非零向量，p，q，r 皆為實數，判斷下列敘述何者正確？",
        "options": [
          {
            "label": "1",
            "text": "若 $p\\vec a+q\\vec b+r\\vec c=\\vec 0$，則 $p=q=r=0$"
          },
          {
            "label": "2",
            "text": "若 $\\vec a=p\\vec b+q\\vec c$，則 $\\vec a$ 在 $\\vec b$ 上的正射影為 $p\\vec b$"
          },
          {
            "label": "3",
            "text": "$\\vec a\\cdot(\\vec b\\times\\vec c)=(\\vec a\\times\\vec b)\\cdot\\vec c$"
          },
          {
            "label": "4",
            "text": "若 $\\vec a\\times\\vec b=\\vec 0$，則 $\\vec a=\\vec 0$ 或 $\\vec b=\\vec 0$"
          },
          {
            "label": "5",
            "text": "$(\\vec a\\times\\vec b)\\cdot(2\\vec a-3\\vec b)=0$"
          }
        ]
      },
