{
  "name": "quiz-api-backend",
  "version": "1.0.0",
  "description": "Backend API for Gemini Quiz Game",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "node server.js",
    "dev": "node server.js",
    "build:world-simulator": "node scripts/build-world-simulator.cjs",
    "check:world-simulator": "node scripts/build-world-simulator.cjs --check",
    "build:module-versions": "node scripts/build-world-simulator.cjs && node scripts/build-module-versions.cjs",
    "check:module-versions": "node scripts/build-world-simulator.cjs --check && node scripts/build-module-versions.cjs --check",
    "migrate:dongtian": "node scripts/migrate-dongtian-to-bd.cjs",
    "migrate:d1": "node scripts/migrate-firestore-to-d1.cjs",
    "test:d1": "node --test tests/d1-*.test.cjs",
    "audit:code": "node --experimental-vm-modules scripts/audit-code.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "firebase-admin": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
