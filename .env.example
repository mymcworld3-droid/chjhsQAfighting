# Existing single Gemini key remains supported
GEMINI_API_KEY=

# Multiple Gemini keys (comma-separated). If both are set, keys are deduplicated.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional comma-separated model rotation, even with ONE Gemini API key.
# Each request uses one model (round-robin); the other is tried only if it fails.
# GEMINI_MODELS takes precedence over GEMINI_MODEL. Leave empty to use GEMINI_MODEL only.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Routing strategy: round-robin (default) or random
AI_PROVIDER_STRATEGY=round-robin
AI_TIMEOUT_MS=25000

# Optional OpenAI-compatible provider shortcut.
# OPENAI_MODEL is required before this provider is enabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional: mix any number of OpenAI-compatible providers.
# Keep this JSON on one line in your real environment configuration.
# Example shape only — do not commit real keys.
AI_PROVIDERS_JSON=[{"name":"provider-a","type":"openai-compatible","baseUrl":"https://example.com/v1","apiKey":"replace-me","model":"replace-me"},{"name":"provider-b","type":"openai-compatible","baseUrl":"https://example.org/v1","apiKey":"replace-me","model":"replace-me"}]

# ===== Firebase A / BD / C cross-project identity (SERVER ONLY) =====
# Each value must be a complete JSON service-account object for THAT project,
# encoded on one line. Set these in the backend host's secret environment settings.
# Do not commit a real service account, private key, token or .env.
# Firebase Console > project settings > Service accounts: A, BD and C separately.
# If any requested project credential is missing, the token endpoint returns 503.
FIREBASE_A_SERVICE_ACCOUNT_JSON=
FIREBASE_BD_SERVICE_ACCOUNT_JSON=
FIREBASE_C_SERVICE_ACCOUNT_JSON=

# Cave migration is a separate, explicit script:
# npm run migrate:dongtian                 # read-only dry run
# npm run migrate:dongtian -- --execute    # copy missing documents; NEVER deletes A
# npm run migrate:dongtian -- --verify-only

# After backing up A and freezing writes to dongtianIndex/dongtians/dongtianReports:
# set to 1 on Render ONLY when the above three server credentials are configured.
# Logged-in players then trigger ONE lease-protected A->BD cave migration.
# All later visitors poll shared status. First login provisions minimal playerProfiles
# in BD/C after verified migration. Default 0 retains existing A-only gameplay.
FIREBASE_AUTO_MIGRATE_ON_START=0
